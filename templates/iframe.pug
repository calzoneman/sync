doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    meta(name="referrer", content="same-origin")
    link(rel="stylesheet", href=asset("/css/video-js.css"))
    link(rel="stylesheet", href=asset("/css/videojs-resolution-switcher.css"))
    style.
      body { overflow-y: hidden }
  body
    #wrap
      #videowrap
        #ytapiplayer
    script.
      const USEROPTS = {
        default_quality: 'auto'
      }
      const CLIENT = {
        leader: false
      }
      let VOLUME = 0;
      function waitUntilDefined(obj, key, fn) {
          if(typeof obj[key] === "undefined") {
              setTimeout(function () {
                  waitUntilDefined(obj, key, fn);
              }, 100);
              return;
          }
          fn();
      }
    script(src=asset("/js/jquery-3.7.1.js"))
    script(src=asset("/js/vjs/video.js"))
    script(src=asset("/js/vjs/videojs-resolution-switcher.js"))
    script(src=asset("/js/playerjs-0.0.12.js"))
    script(src=asset("/js/player.js"))
